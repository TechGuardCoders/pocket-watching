# Cost Peep configuration
# Copy to .env.local and edit. NEVER commit .env.local.

# Mode: "mock" (simulated telemetry, default) or "live" (scrape vLLM /metrics)
COST_PEEP_MODE=mock

# Base URL of the vLLM API server (head node), e.g. http://<head-node>:8000
VLLM_BASE_URL=

# Bearer token for /metrics if the deployment requires auth.
# Prefer Azure Key Vault → GitHub Actions secrets for CI; locally .env.local only.
VLLM_API_KEY=
